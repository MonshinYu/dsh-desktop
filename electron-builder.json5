{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.deepseek.dsh-desktop",
  "productName": "DSH Desktop",
  "copyright": "Copyright © 2026 MonshinYu",
  "asar": true,
  "asarUnpack": [
    "node_modules/**"
  ],
  "npmRebuild": false,
  "directories": {
    "output": "release/${version}",
    "buildResources": "public"
  },
  "files": [
    "dist",
    "dist-electron",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist-electron/main.js"
  },
  "publish": {
    "provider": "github",
    "owner": "MonshinYu",
    "repo": "dsh-desktop",
    "releaseType": "release"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "public/favicon.png",
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null
  },
  "dmg": {
    "title": "${productName} ${version}",
    "writeUpdateInfo": true
  },
  "win": {
    "icon": "public/favicon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "publisherName": "MonshinYu"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DSH Desktop"
  },
  "linux": {
    "icon": "public/favicon.png",
    "target": [
      "AppImage",
      "deb"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "category": "Development",
    "synopsis": "Desktop client for @deepseek-ai/dsh",
    "description": "A community-maintained desktop client for @deepseek-ai/dsh - wrap the dsh Web UI in a native window, no Node.js or Bun required for end users."
  }
}
